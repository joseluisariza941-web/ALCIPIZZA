# Copia este archivo como ".env" (nunca se sube a git)

# --- MySQL (docker-compose.yml de la raíz) ---
DB_HOST=127.0.0.1
DB_PORT=3310
DB_NAME=alcipizza
DB_USER=alcipizza
DB_PASSWORD=Alcipizza_Dev_2026

# --- Servidor ---
PORT=3000
NODE_ENV=development
# Texto largo y aleatorio (mínimo 32 caracteres) para firmar la cookie de sesión (se usa en la fase 1)
SESSION_SECRET=

# --- Usuarios iniciales: solo los usa el seed. Mínimo 8 caracteres.
# Al entrar por primera vez se obligará a cambiar la contraseña (fase 1).
DEV_USER=dev
DEV_PASS=
ADMIN_USER=admin
ADMIN_PASS=
MESERA_USER=ana
MESERA_PASS=
