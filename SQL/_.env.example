# ===== Copia este archivo como ".env" y completa tus datos =====
# (el archivo .env NUNCA se sube a GitHub)

# --- SQL Server ---
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=Alcipizza
DB_USER=sa
DB_PASSWORD=CambiaEstaClave_123
DB_ENCRYPT=false          # true para Azure SQL
DB_TRUST_CERT=true        # true para SQL Server local con certificado propio

# --- Servidor ---
PORT=3000
# Texto largo y aleatorio (mínimo 24 caracteres) para firmar las sesiones:
TOKEN_SECRET=
# Si la página se sirve desde otro dominio (por ejemplo GitHub Pages), escríbelo aquí:
# CORS_ORIGIN=https://tuusuario.github.io
# Si usas un proxy inverso con HTTPS (Nginx, Caddy, Azure…), pon 1:
TRUST_PROXY=0

# --- Usuarios iniciales (solo se usan la PRIMERA vez que arranca el servidor) ---
# Usuario y contraseña (mínimo 6 caracteres) del desarrollador y de la administración de cocina.
DEV_USER=
DEV_PASS=
ADMIN_USER=
ADMIN_PASS=
